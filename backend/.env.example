# ── Server ───────────────────────────────────────────────
PORT=8000
# Frontend URL: used for CORS and for links in verification emails
APP_URL=http://localhost:5173
# Behind a reverse proxy (Render, Railway, Nginx…), set to the number of proxy hops (usually 1)
# so rate limits see each client's IP instead of the proxy's.
# TRUST_PROXY=1

# ── AI model ─────────────────────────────────────────────
# Any OpenAI-compatible /chat/completions API works. Set its base URL, a model it serves,
# and (if it needs one) an API key. Leave AI_BASE_URL or AI_MODEL empty to run on built-in rules.
#
# Example AI_BASE_URL values:
#   Groq         https://api.groq.com/openai/v1
#   OpenAI       https://api.openai.com/v1
#   Gemini       https://generativelanguage.googleapis.com/v1beta/openai
#   OpenRouter   https://openrouter.ai/api/v1
#   Together     https://api.together.xyz/v1
#   Mistral      https://api.mistral.ai/v1
#   DeepSeek     https://api.deepseek.com/v1
#   xAI          https://api.x.ai/v1
#   Ollama       http://localhost:11434/v1   (no API key needed)
#   LM Studio    http://localhost:1234/v1    (no API key needed)
#
# For Anthropic (Claude), set AI_API_STYLE=anthropic, AI_BASE_URL=https://api.anthropic.com
# and an AI_API_KEY (required in this style).
#
# Complete working example (Groq):
AI_BASE_URL=https://api.groq.com/openai/v1
AI_API_KEY=your_groq_api_key_here
AI_MODEL=llama-3.3-70b-versatile
# AI_API_STYLE=openai   # "openai" (default) or "anthropic"

# Optional
# AI_MAX_TOKENS=        # output-token limit per request (raise for reasoning models)
# AI_EFFORT=            # reasoning effort for models that support it: low | medium | high
# AI_TIMEOUT_MS=60000   # per-request timeout

# ── AI cost protection ───────────────────────────────────
# Every AI endpoint is rate-limited per IP: AI_RATE_LIMIT requests per 5 minutes (default 60),
# and form uploads (/api/analyze-pdf) AI_UPLOAD_RATE_LIMIT per 15 minutes (default 10).
# AI_RATE_LIMIT=60
# AI_UPLOAD_RATE_LIMIT=10
# Set to true to allow only signed-in users to use the AI endpoints (needs the database below).
# Off by default so the demo works without accounts; signed-out users then get the built-in rules.
REQUIRE_LOGIN_FOR_AI=false

# ── Database (PostgreSQL) — optional ─────────────────────
# Only needed for accounts (sign-up / sign-in). Leave it empty and the app still works:
# the Sign in button is hidden and forms are filled without an account.
# Tables are created automatically on startup.
DATABASE_URL=postgres://postgres:your_password@localhost:5432/civiguide

# ── Sessions (required when DATABASE_URL is set) ─────────
# Long random string; in production (NODE_ENV=production) the server refuses to start
# with "change_me" or anything shorter than 32 characters. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_SECRET=change_me

# ── Email verification (SMTP) ────────────────────────────
# If SMTP_HOST is empty in development, verification links are printed to the console instead.
# Gmail example: SMTP_HOST=smtp.gmail.com, SMTP_PORT=465, SMTP_SECURE=true,
#                SMTP_USER=you@gmail.com, SMTP_PASS=<16-char Google App Password>
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM="CiviGuide AI <no-reply@example.com>"

# ── Google sign-in ───────────────────────────────────────
# OAuth 2.0 Client ID (type "Web application") from Google Cloud Console → APIs & Services → Credentials.
# Add your frontend URL (e.g. http://localhost:5173) under "Authorized JavaScript origins".
# Leave empty to hide the Google button.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
